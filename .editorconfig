# see: http://editorconfig.org

root = true

[*]
charset = utf-8
trim_trailing_whitespace = true
end_of_line = lf
indent_style = space
insert_final_newline = true
indent_size = 2

[*.{rs,py,pyi,ini}]
indent_size = 4

[*.md]
max_line_length = 100

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2
